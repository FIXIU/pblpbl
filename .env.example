# Coating Reflectivity Research Station ("Sztuczny Dach")
# Configuration Environment Variables

# Operation Mode (Set to false when running on physical Raspberry Pi 5)
SIMULATION_MODE=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000

# SSR-40DA Heating Lamp Relay
SSR_GPIO_PIN=18
SSR_PWM_WINDOW_SEC=2.0

# MAX6675 Thermocouple Sensor (Hardware SPI0)
MAX6675_SPI_BUS=0
MAX6675_SPI_DEVICE=0
MAX6675_POLL_RATE_HZ=4.0

# MLX90640 Thermal Camera (Hardware I2C1)
MLX90640_I2C_BUS=1
MLX90640_I2C_ADDR=0x33
MLX90640_FPS=4

# Default 10x15 cm Plate ROI (32x24 grid: x 0..31, y 0..23)
DEFAULT_ROI_X_MIN=8
DEFAULT_ROI_X_MAX=24
DEFAULT_ROI_Y_MIN=6
DEFAULT_ROI_Y_MAX=18

# Safety Watchdog Thresholds (°C)
SAFETY_MAX_BACK_TEMP=110.0
SAFETY_MAX_SURF_TEMP=120.0
SAFETY_DISCONNECT_TIMEOUT_SEC=1.5

# Anti-Glare Snapshot ("Pomiar bez odbić IR")
ANTI_GLARE_DEFAULT_INTERVAL_SEC=30.0
ANTI_GLARE_COOLDOWN_SEC=1.5

# Data Storage
DATA_DIR=backend/data/sessions
